# Exchange connection
EXCHANGE_ID=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h
DATA_LIMIT=500

# API keys (set your actual key in .env — not committed)
OPENAI_API_KEY=sk-your-key-here

# Freqtrade
BACKTEST_CONFIG_PATH=./ft_userdata/config.json

# Memory
CHROMA_DB_PATH=./chroma_db

# Workspace
WORKSPACE_REGISTRY_PATH=./workspace_registry.json

# Paper trading
PAPER_INITIAL_BALANCE=10000.0

# LLM provider — works with OpenAI, DeepSeek, OpenRouter, etc.
# For OpenAI:            OPENAI_BASE_URL=https://api.openai.com/v1
# For OpenRouter:        OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For DeepSeek direct:   OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# Backtest timeout (seconds)
BACKTEST_TIMEOUT=300

# Sentiment (optional — free tier works without keys)
CRYPTOPANIC_API_KEY=
COINGECKO_API_KEY=
WHALE_ALERT_API_KEY=

# HuggingFace (optional — suppresses model download warning)
HF_TOKEN=

# Feature flags
ENABLE_SENTIMENT=true
ENABLE_PATTERNS=true
ENABLE_ONCHAIN=false

# Autonomous mode
AUTONOMOUS_INTERVAL_MINUTES=30
DECAY_THRESHOLD=0.20
COVERAGE_GAP_SHARPE=0.80
MAX_DAYS_WITHOUT_REGIME_RESEARCH=7

# Live execution (paper is default)
EXECUTION_MODE=paper
LIVE_MAX_POSITION_USDT=100
TWAP_THRESHOLD_USDT=500
STOP_LOSS_DEFAULT=0.04
TAKE_PROFIT_DEFAULT=0.08

# Multi-exchange
EXCHANGES=binance
FUTURES_ENABLED=false

# Anti-overfitting & data integrity
BACKTEST_OPTIMISM_FACTOR=0.55
LIVE_START_DATE=
VALIDATION_MODE_DAYS=90

# Telegram alerts (optional — human-in-the-loop for trade approval)
# Get token from @BotFather on Telegram
# Chat ID: message @userinfobot to find yours
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis (optional — StateBroker uses in-memory by default)
REDIS_URL=